{
  "name": "rust-skills",
  "version": "2.2.0",
  "private": false,
  "description": "Rust development skills with local routing runtime for Codex and Claude Code",
  "license": "MIT",
  "bin": {
    "rust-skills": "./rust-skills.js"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "README-ja.md",
    "README-zh.md",
    "VERSION",
    "metadata.json",
    "package.json",
    "rust-skills.js",
    "install.js",
    "setup.sh",
    ".claude/hooks/",
    ".claude/settings.example.json",
    ".claude-plugin/",
    ".codex/INSTALL.md",
    ".codex/hooks/",
    ".opencode/",
    "_meta/",
    "agents/",
    "cache/",
    "commands/",
    "crates/",
    "docs/",
    "hooks/hooks.json",
    "index/",
    "installer/",
    "lib/",
    "references/",
    "skills/",
    "templates/"
  ],
  "scripts": {
    "test": "node tests/verify-all.mjs",
    "verify": "node tests/verify-all.mjs",
    "test:rust-cli-parity": "node tests/rust-cli-parity-test.mjs",
    "test:aom": "node tests/aom/run-routing-aom.mjs",
    "test:skill-generation": "node tests/aom/run-skill-generation-gate.mjs --skills skills --baseline tests/aom/skill-gate-baseline.json --json",
    "test:skill-generation:write-baseline": "node tests/aom/run-skill-generation-gate.mjs --skills skills --write-baseline tests/aom/skill-gate-baseline.json",
    "test:aom:evaluator": "node tests/aom/run-evaluator-self-test.mjs",
    "test:aom:fixtures": "node tests/aom/run-agent-fixture-audit.mjs",
    "test:aom:cli-fixtures": "node tests/aom/run-agent-fixture-audit.mjs --cases tests/aom/fixtures/agent-matrix-cli.json --profile cli --report tests/results/agent-fixture-audit-cli-report.json",
    "test:agents": "node tests/aom/run-agent-matrix.mjs --allow-real-agents --require-real-agents",
    "test:agents:comprehensive": "node tests/aom/run-agent-matrix.mjs --cases tests/aom/fixtures/agent-matrix-comprehensive.json --allow-real-agents --require-real-agents",
    "test:agents:comprehensive:benchmark": "node tests/aom/run-agent-matrix.mjs --cases tests/aom/fixtures/agent-matrix-comprehensive.json --benchmark-mode --allow-real-agents --require-real-agents",
    "test:agents:comprehensive:skip": "node tests/aom/run-agent-matrix.mjs --cases tests/aom/fixtures/agent-matrix-comprehensive.json --benchmark-mode",
    "test:agents:cli": "node tests/aom/run-agent-matrix.mjs --cases tests/aom/fixtures/agent-matrix-cli.json --allow-real-agents --require-real-agents",
    "test:agents:cli:benchmark": "node tests/aom/run-agent-matrix.mjs --cases tests/aom/fixtures/agent-matrix-cli.json --benchmark-mode --allow-real-agents --require-real-agents",
    "test:agents:cli:skip": "node tests/aom/run-agent-matrix.mjs --cases tests/aom/fixtures/agent-matrix-cli.json --benchmark-mode",
    "test:agents:skip": "node tests/aom/run-agent-matrix.mjs",
    "test:regeneration-compare": "node tests/aom/run-clean-regeneration-compare.mjs",
    "materialize:regenerated-root": "node tests/aom/materialize-regenerated-root.mjs",
    "test:harvest": "node tests/aom/run-validation-harvest.mjs",
    "test:harvest:focused": "node tests/aom/run-validation-harvest.mjs --case-filter codegen-owned-index --repeats 1 --concurrency 2",
    "test:harvest:cli": "node tests/aom/run-validation-harvest.mjs --cases tests/aom/fixtures/agent-matrix-cli.json --repeats 3 --concurrency 4",
    "test:harvest:remote": "node tests/aom/run-validation-harvest.mjs --no-local --case-filter codegen-owned-index --repeats 1 --concurrency 2",
    "test:agents:report": "node tests/aom/summarize-agent-report.mjs",
    "test:controlled-rollup": "node tests/aom/summarize-controlled-rollup.mjs",
    "route": "cargo run --quiet -p rust-skills-cli --bin rust-skills -- route --json"
  },
  "engines": {
    "node": ">=18"
  }
}
